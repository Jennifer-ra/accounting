page {
  background: #f6f7fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #64748b;
}

.amount-expense {
  color: #ef4444;
}

.amount-income {
  color: #16a34a;
}

.primary-btn {
  background: #2563eb;
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 600;
}

.secondary-btn {
  background: #eef2ff;
  color: #1d4ed8;
  border-radius: 999rpx;
  font-weight: 600;
}

.danger-btn {
  background: #fee2e2;
  color: #b91c1c;
  border-radius: 999rpx;
  font-weight: 600;
}

button::after {
  border: none;
}

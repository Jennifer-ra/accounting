<view class="container">
  <view class="card profile-card">
    <view class="app-name">轻记账</view>
    <view class="muted">本地优先，可切换云端同步</view>
    <view class="count">{{billCount}} 笔账单</view>
  </view>

  <view class="card section-card">
    <view class="row between cloud-row">
      <view>
        <view class="section-title">云端模式</view>
        <view class="muted small">关闭时完全使用本地缓存</view>
      </view>
      <switch checked="{{cloudEnabled}}" bindchange="onCloudModeChange" />
    </view>
    <view class="inline-form two-col cloud-form">
      <input value="{{apiBaseUrl}}" data-field="apiBaseUrl" bindinput="onInput" placeholder="API 地址" />
      <button class="secondary-btn inline-btn" bindtap="saveApiBaseUrl">保存</button>
    </view>
    <button wx:if="{{cloudEnabled}}" class="primary-btn cloud-btn" loading="{{syncing}}" bindtap="loginAndSync">登录并同步</button>
  </view>

  <view class="card section-card">
    <view class="section-title">本月预算</view>
    <view class="inline-form two-col">
      <input type="digit" value="{{monthlyBudget}}" data-field="monthlyBudget" bindinput="onInput" placeholder="例如 3000" />
      <button class="primary-btn inline-btn" bindtap="saveBudget">保存</button>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-title">分类</view>
    <view class="tag-group">
      <text wx:for="{{categories.expense}}" wx:key="*this" class="tag expense-tag">{{item}}</text>
    </view>
    <view class="tag-group">
      <text wx:for="{{categories.income}}" wx:key="*this" class="tag income-tag">{{item}}</text>
    </view>
    <view class="inline-form">
      <picker mode="selector" range="{{categoryTypes}}" value="{{categoryTypeIndex}}" bindchange="onCategoryTypeChange">
        <view class="type-picker">{{categoryTypes[categoryTypeIndex]}}</view>
      </picker>
      <input value="{{newCategory}}" data-field="newCategory" bindinput="onInput" placeholder="新分类" />
      <button class="secondary-btn inline-btn" bindtap="addCategory">添加</button>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-title">账户</view>
    <view class="tag-group">
      <text wx:for="{{accounts}}" wx:key="*this" class="tag account-tag">{{item}}</text>
    </view>
    <view class="inline-form two-col">
      <input value="{{newAccount}}" data-field="newAccount" bindinput="onInput" placeholder="新账户" />
      <button class="secondary-btn inline-btn" bindtap="addAccount">添加</button>
    </view>
  </view>

  <view class="card action-card">
    <button class="secondary-btn" bindtap="exportData">导出到剪贴板</button>
    <button class="secondary-btn" bindtap="importData">从剪贴板导入 JSON/CSV</button>
    <button class="danger-btn" bindtap="clearData">清空本地数据</button>
  </view>

  <view class="tips muted">
    云端模式需要后端服务可访问。开发阶段可用本机 API 地址，发布上线前需要配置 HTTPS 域名和微信小程序 request 合法域名。
  </view>
</view>

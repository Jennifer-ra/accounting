.month-picker {
  display: inline-block;
  margin-bottom: 24rpx;
  padding: 14rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  color: #0f172a;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.summary-card {
  margin-bottom: 28rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.budget-box {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e2e8f0;
}

.section-title {
  margin: 30rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.rank-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.rank-item:first-child {
  padding-top: 0;
}

.rank-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.bar {
  height: 14rpx;
  margin-top: 16rpx;
  overflow: hidden;
  background: #e2e8f0;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.expense-fill {
  background: #ef4444;
}

.income-fill {
  background: #16a34a;
}

.budget-fill {
  background: #2563eb;
}

.empty {
  text-align: center;
  padding: 30rpx 0;
}
